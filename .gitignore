.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# Data (keep structure, not large binaries)
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Experiment artifacts (large / regenerable)
experiments/checkpoints/*
!experiments/checkpoints/.gitkeep
# Phase 6 checkpoints (regenerable; 50 files per run-tag)
experiments/checkpoints_phase6_*/
# Phase 11 surrogate model artifacts (regenerable via scripts/phase11_train_surrogate.py;
# ~1.2GB of joblib-dumped sklearn models -- held-out metrics are in the phase report, not here)
experiments/surrogate_models/
# Per-experiment diagnostic figures written by the runner (regenerable; not the final figure set)
reports/figures/EXP_P6*.png
# Static-site build output (regenerable via demo/scripts/build_static_site.py; deployed to the
# separate gh-pages branch via demo/scripts/deploy_github_pages.sh, never committed here)
demo/static-site/
experiments/logs/*
!experiments/logs/.gitkeep

# hls4ml generated projects
*_hls_project/
hls4ml_prj*/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# secrets
.env
*.key
hls4ml_csim/

